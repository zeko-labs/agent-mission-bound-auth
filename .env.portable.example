BASE_URL=https://your-mission-authority.example
PUBLIC_BASE_URL=https://your-mission-authority.example
DEMO_MODE=false
MISSION_AUTH_PROFILE=portable
MISSION_SETTLEMENT_PROFILE=none
MAX_JSON_BODY_BYTES=1000000

# Enterprise OIDC verification.
OIDC_ISSUER=https://your-idp.example.com/oauth2/default
OIDC_AUDIENCE=agent-mission-auth-api
OIDC_JWKS_URL=https://your-idp.example.com/oauth2/default/v1/keys

# Mission authority signing and control-plane authentication.
ZK_OAUTH_ISSUER_SECRET=replace-with-secret-manager-value
MISSION_AUTHORITY_PRIVATE_JWK={"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"...","d":"..."}
MISSION_APPROVAL_BEARER_TOKEN=replace-with-approval-authority-token

# Durable replay, budget, mission, and revocation state.
MISSION_STATE_PATH=/var/lib/agent-mission-bound-auth/mission-state.json
REVOCATION_STATE_PATH=/var/lib/agent-mission-bound-auth/revocation-state.json

# No facilitator, Zeko deployer, registry, Pallas verifier, or compute operator
# is required for portable browser and extension authorization.
