{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/capability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilityId", "capabilityHash", "issuer", "audience", "principalHash", "agentId", "holderKeyCommitment", "missionIdHash", "allowedActions", "paymentRails", "expiresAt", "jti", "nullifierCommitment", "settlementReleaseCondition", "nullifier", "authorityJws"],
  "properties": {
    "version": { "const": "mission-bound-capability-v1" },
    "capabilityId": { "type": "string" },
    "capabilityHash": { "type": "string" },
    "issuer": { "type": "string" },
    "audience": { "type": "string" },
    "principalHash": { "type": "string" },
    "authCommitment": { "type": "string" },
    "identityAttestationHash": { "type": "string" },
    "agentId": { "type": "string" },
    "runtimeId": { "type": "string" },
    "holderKeyCommitment": { "type": "string" },
    "zekoBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "network",
        "networkName",
        "signingNetworkId",
        "nativeAsset",
        "missionIdHash",
        "authCommitment",
        "missionIdHashField",
        "authCommitmentField",
        "holderPublicKey",
        "holderKeyCommitment",
        "domainVerifierPublicKey",
        "domainVerifierKeyCommitment",
        "allowedActions",
        "allowedDomains",
        "allowedActionsRoot",
        "allowedDomainsRoot",
        "datasetCommitment",
        "policyCommitment",
        "capabilityCommitment",
        "approvalCommitment",
        "nullifier",
        "validUntilSlot",
        "maxSpendMicrousd",
        "beneficiary",
        "payoutNanomina",
        "protocolFeeNanomina",
        "payoutNativeUnits",
        "protocolFeeNativeUnits"
      ],
      "properties": {
        "version": {
          "enum": [
            "mba-zeko-capability-binding-v2",
            "mba-zeko-capability-binding-v3"
          ]
        },
        "network": { "enum": ["zeko:testnet", "zeko:sepolia"] },
        "protocolNetworkId": { "const": "zeko:sepolia" },
        "graphqlNetworkId": { "const": "zeko:testnet" },
        "networkName": { "const": "Zeko Ethereum Sepolia" },
        "signingNetworkId": { "const": "testnet" },
        "nativeAsset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol", "decimals", "standard", "tokenId"],
          "properties": {
            "symbol": { "const": "sETH" },
            "decimals": { "const": 9 },
            "standard": { "const": "native" },
            "tokenId": { "type": "string", "minLength": 1 }
          }
        },
        "missionIdHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authCommitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "missionIdHashField": { "type": "string", "pattern": "^[0-9]+$" },
        "authCommitmentField": { "type": "string", "pattern": "^[0-9]+$" },
        "holderPublicKey": { "type": "string", "minLength": 1 },
        "holderKeyCommitment": { "type": "string", "pattern": "^[0-9]+$" },
        "domainVerifierPublicKey": { "type": "string", "minLength": 1 },
        "domainVerifierKeyCommitment": { "type": "string", "pattern": "^[0-9]+$" },
        "allowedActions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allowedDomains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allowedActionsRoot": { "type": "string", "pattern": "^[0-9]+$" },
        "allowedDomainsRoot": { "type": "string", "pattern": "^[0-9]+$" },
        "datasetCommitment": { "type": "string", "pattern": "^[0-9]+$" },
        "policyCommitment": { "type": "string", "pattern": "^[0-9]+$" },
        "capabilityCommitment": { "type": "string", "pattern": "^[0-9]+$" },
        "approvalCommitment": { "type": "string", "pattern": "^[0-9]+$" },
        "nullifier": { "type": "string", "pattern": "^[0-9]+$" },
        "validUntilSlot": { "type": "string", "pattern": "^[0-9]+$" },
        "maxSpendMicrousd": { "type": "string", "pattern": "^[0-9]+$" },
        "beneficiary": { "type": "string", "minLength": 1 },
        "payoutNanomina": { "type": "string", "pattern": "^[0-9]+$" },
        "protocolFeeNanomina": { "type": "string", "pattern": "^[0-9]+$" },
        "payoutNativeUnits": { "type": "string", "pattern": "^[0-9]+$" },
        "protocolFeeNativeUnits": { "type": "string", "pattern": "^[0-9]+$" }
      },
      "if": {
        "properties": {
          "version": { "const": "mba-zeko-capability-binding-v3" }
        },
        "required": ["version"]
      },
      "then": {
        "required": ["protocolNetworkId", "graphqlNetworkId"],
        "properties": {
          "network": { "const": "zeko:sepolia" },
          "protocolNetworkId": { "const": "zeko:sepolia" },
          "graphqlNetworkId": { "const": "zeko:testnet" }
        }
      },
      "else": {
        "properties": {
          "network": { "const": "zeko:testnet" },
          "protocolNetworkId": false,
          "graphqlNetworkId": false
        }
      }
    },
    "missionIdHash": { "type": "string" },
    "missionId": { "type": "string" },
    "approvalHash": { "type": "string" },
    "policyHash": { "type": "string" },
    "allowedDomains": { "type": "array", "items": { "type": "string" } },
    "allowedActions": { "type": "array", "items": { "type": "string" } },
    "dataScopes": { "type": "array", "items": { "type": "string" } },
    "paymentRails": { "type": "array", "items": { "type": "string" } },
    "maxSpendUsd": { "type": "string" },
    "expiresAt": { "type": "string" },
    "jti": { "type": "string" },
    "nullifierCommitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "settlementReleaseCondition": { "type": "string" },
    "previousCapabilityHash": { "type": "string" },
    "renewalCounter": { "type": "integer", "minimum": 1 },
    "renewalReason": { "type": "string" },
    "replacedJti": { "type": "string" },
    "nullifier": { "type": "string" },
    "authorityJws": { "type": "string" }
  }
}
