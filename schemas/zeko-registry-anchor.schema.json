{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeko.io/mba/schemas/zeko-registry-anchor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "networkId",
    "registryAddress",
    "transactionHash",
    "sequence",
    "registryRoot",
    "missionIdHash",
    "capabilityCommitment",
    "approvalCommitment",
    "receiptCommitment",
    "nullifier",
    "paymentContextDigest",
    "beneficiary",
    "payoutNanomina",
    "protocolFeeNanomina",
    "proofArtifactHash",
    "anchoredAt",
    "anchorId",
    "anchorHash"
  ],
  "properties": {
    "version": { "const": "mba-zeko-registry-anchor-v1" },
    "networkId": { "const": "zeko:testnet" },
    "registryAddress": { "type": "string", "pattern": "^B62" },
    "transactionHash": { "type": "string", "minLength": 1 },
    "sequence": { "$ref": "#/$defs/uint" },
    "registryRoot": { "$ref": "#/$defs/uint" },
    "missionIdHash": { "$ref": "#/$defs/uint" },
    "capabilityCommitment": { "$ref": "#/$defs/uint" },
    "approvalCommitment": { "$ref": "#/$defs/uint" },
    "receiptCommitment": { "$ref": "#/$defs/uint" },
    "nullifier": { "$ref": "#/$defs/uint" },
    "paymentContextDigest": { "$ref": "#/$defs/uint" },
    "beneficiary": { "type": "string", "pattern": "^B62" },
    "payoutNanomina": { "$ref": "#/$defs/uint" },
    "protocolFeeNanomina": { "$ref": "#/$defs/uint" },
    "proofArtifactHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blockHeight": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
    "anchoredAt": { "type": "string", "format": "date-time" },
    "anchorId": { "type": "string", "minLength": 1 },
    "anchorHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "uint": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
