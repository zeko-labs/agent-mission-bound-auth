{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeko.io/mba/schemas/enterprise-identity-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "issuer",
    "source",
    "principal",
    "grants",
    "authCommitment",
    "scopeCommitment",
    "issuedAt",
    "expiresAt",
    "jti",
    "attestationHash",
    "authorityJws"
  ],
  "properties": {
    "version": { "const": "mba-enterprise-identity-attestation-v1" },
    "issuer": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "provider", "issuer", "subjectHash", "audience", "tokenHash", "tokenExpiresAt"],
      "properties": {
        "protocol": { "const": "oidc" },
        "provider": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "subjectHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "audience": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "tokenHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tokenExpiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "organization", "represents"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "represents": { "type": ["object", "null"] }
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopes", "computeScopes", "datasetScopes", "railScopes", "maxSpendUsd"],
      "properties": {
        "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "computeScopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "datasetScopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "railScopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "maxSpendUsd": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$" }
      }
    },
    "authCommitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scopeCommitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "jti": { "type": "string", "minLength": 1 },
    "attestationHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorityJws": { "type": "string", "minLength": 1 }
  }
}
