{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agent-passport.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "agentId", "agentIdentifier", "represents", "vouchedBy", "keyBinding", "passportId", "passportCommitment", "authorityJws"],
  "properties": {
    "version": { "const": "agent-passport-v1" },
    "agentId": { "type": "string", "minLength": 1 },
    "agentIdentifier": { "type": "string", "minLength": 1 },
    "represents": { "type": "object" },
    "vouchedBy": { "type": "array", "minItems": 1 },
    "keyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "jwksUri", "holderKeyCommitment", "zekoHolderPublicKey", "zekoHolderKeyCommitment"],
      "properties": {
        "method": { "type": "string" },
        "jwksUri": { "type": "string" },
        "holderKeyCommitment": { "type": ["string", "null"] },
        "zekoHolderPublicKey": { "type": ["string", "null"] },
        "zekoHolderKeyCommitment": { "type": ["string", "null"] }
      }
    },
    "authCommitment": { "type": ["string", "null"] },
    "identityAttestationHash": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "passportId": { "type": "string" },
    "passportCommitment": { "type": "string" },
    "authorityJws": { "type": "string" },
    "authoritySignature": { "type": ["string", "null"] }
  }
}
