BASE_URL=https://your-sidecar.example
PUBLIC_BASE_URL=https://your-sidecar.example
DEMO_MODE=false
MISSION_AUTH_PROFILE=production
MISSION_SETTLEMENT_PROFILE=zeko
MAX_JSON_BODY_BYTES=1000000

# Enterprise OAuth / OIDC provider.
OIDC_ISSUER=https://your-idp.example.com/oauth2/default
OIDC_AUDIENCE=private-compute-api
OIDC_JWKS_URL=https://your-idp.example.com/oauth2/default/v1/keys

# Provider-specific OAuth login configs for the sidecar.
AUTH0_ISSUER=https://your-auth0-tenant.us.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
OKTA_ISSUER=https://your-okta-domain.okta.com
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_AUDIENCE=
OKTA_SCOPE=openid profile email

# Additional customer IdPs.
# OIDC_PROVIDERS_JSON='[{"provider":"customer-a","issuer":"https://idp.example.com","clientId":"...","clientSecret":"...","scope":"openid profile email"}]'
# Map verified provider subjects to internal agent records.
# AGENT_MAPPINGS_JSON='[{"subjectKey":"okta:https://your-okta-domain.okta.com/:00u...","agentId":"agent-research-001","represents":{"type":"organization","id":"Acme"}}]'

# Commitment issuer secret. Store outside git in production.
ZK_OAUTH_ISSUER_SECRET=replace-with-secret-manager-value
MISSION_AUTHORITY_PRIVATE_JWK={"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"...","d":"..."}
MISSION_APPROVAL_BEARER_TOKEN=replace-with-approval-authority-token
# Pallas keys trusted to attest domain proof/output correctness in the ZK proof.
DOMAIN_VERIFIER_PALLAS_PUBLIC_KEYS_JSON=["B62..."]
MISSION_STATE_PATH=/var/lib/agent-mission-bound-auth/mission-state.json
REVOCATION_STATE_PATH=/var/lib/agent-mission-bound-auth/revocation-state.json

# x402 v2 facilitator. The server calls /verify and then /settle.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# Include the complete scheme required by your facilitator, for example Bearer.
X402_FACILITATOR_AUTHORIZATION=

# x402 pay-to values.
ZEKO_PAY_TO=B62...
ZEKO_BENEFICIARY=B62...
ETHEREUM_PAY_TO=0x...
BASE_PAY_TO=0x...

# Preview EVM rails are advertised only when explicitly enabled and fully configured.
ENABLE_ARC_RAIL=false
ARC_PAY_TO=
ARC_ASSET=
ENABLE_TEMPO_RAIL=false
TEMPO_PAY_TO=
TEMPO_ASSET=

# Aggregate-output policy.
PRIVATE_COMPUTE_MIN_COHORT=3

# Zeko Ethereum Sepolia profile. `testnet` is the required o1js/Auro signing
# domain; it is not a Mina deployment selector. The endpoint currently serves
# the actions/events reads MBA needs, so it is used for both o1js URLs.
ZEKO_GRAPHQL=https://sepolia.zeko.io/graphql
ZEKO_ARCHIVE=https://sepolia.zeko.io/graphql
ZEKO_NETWORK_ID=testnet
ZEKO_NETWORK_NAME="Zeko Ethereum Sepolia"
ZEKO_NATIVE_ASSET=sETH
ZEKO_NATIVE_DECIMALS=9
ZEKO_NATIVE_TOKEN_ID=wSHV2S4qX9jFsLjQo8r1BsMLH2ZRKsZx6EJd1sbozGPieEC4Jf
TX_FEE=200000

# Zeko deploy keys. Keep out of git.
DEPLOYER_PRIVATE_KEY=EK...
ZKAPP_PRIVATE_KEY=EK...
MISSION_AUTHORITY_ZEKO_PRIVATE_KEY=EK...
MISSION_AUTHORITY_ZEKO_PUBLIC_KEY=B62...
MISSION_PROTOCOL_FEE_RECIPIENT=B62...
MISSION_REGISTRY_PUBLIC_KEY=B62...
MISSION_REGISTRY_STATE_PATH=/var/lib/agent-mission-bound-auth/mission-registry-state.zeko-sepolia.json
PRIVATE_COMPUTE_BENEFICIARY_PUBLIC_KEY=B62...
